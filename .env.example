# rag-enterprise-agent environment template
# Copy to .env and fill real values only on machines you control.
# NEVER commit .env (it is gitignored). All values below are SAFE DUMMIES.
# Cloud vars are used ONLY by azure_adapters/ (lazy imports).

# ---- generation provider -------------------------------------------
# fake | ollama | openai | azure
LLM_PROVIDER=fake

# Ollama (default local provider): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Any OpenAI-compatible endpoint (vLLM, LiteLLM, OpenRouter, OpenAI itself)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=dummy-openai-key

# Azure OpenAI: AZURE_OPENAI_DEPLOYMENT is the DEPLOYMENT NAME you created
# in the portal (not the raw model name). NEVER TESTED AGAINST LIVE SERVICE.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=dummy-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=dummy-chat-deployment
# embeddings deployment (used by azure_adapters/azure_openai_embedder.py)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=dummy-embedding-deployment

# ---- embedding -------------------------------------------------------
# local pre-trained model (sentence-transformers) or "fake" via --fake flags
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- retrieval / pipeline tuning (defaults in rag/config.py) ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHUNKING_STRATEGY=sentence
TOP_K=4
CANDIDATE_K=20
RRF_K=60
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
NO_ANSWER_THRESHOLD=0.35
NO_ANSWER_THRESHOLD_BM25=2.0
NO_ANSWER_THRESHOLD_RERANK=0.3
PROMPT_VERSION=v2
SEED=42

# ---- API --------------------------------------------------------------
# empty = auth DISABLED (dev only; a warning is logged). Set a strong value.
API_KEY=change-me-dev-key
CORS_ORIGINS=http://localhost:8000
MAX_QUESTION_LENGTH=1000
LOG_LEVEL=INFO

# ---- Azure AI Search (azure_adapters only; NOT TESTED LIVE) -----------
SEARCH_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_INDEX=dummy-events-kb
SEARCH_KEY=dummy-search-admin-key

# ---- Microsoft Graph / SharePoint (azure_adapters only; NOT TESTED LIVE)
# app registration with application permission Sites.Read.All + admin consent
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=dummy-graph-secret
SHAREPOINT_SITE_ID=contoso.sharepoint.com,00000000-0000-0000-0000-000000000000
SHAREPOINT_FOLDER=/sites/events-kb/Shared Documents/policies
# "path-substring:role1,role2;other-substring:hr"
SHAREPOINT_ROLE_MAP=hr:hr;venue:staff,manager;support:staff,manager

# ---- Teams webhook (azure_adapters only; NOT TESTED LIVE) -------------
TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/dummy-id
